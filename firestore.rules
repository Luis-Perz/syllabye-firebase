rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
function verified() {
  return request.auth != null && request.auth.token.email_verified == true;
}

function isAdmin() {
  return verified()
    && exists(/databases/$(database)/documents/roles/$(request.auth.token.email.lower()))
    && get(/databases/$(database)/documents/roles/$(request.auth.token.email.lower())).data.role == 'admin';
}

    // ---------- collections ----------
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /roles/{email} {
      allow read: if verified() && (request.auth.token.email.lower() == email || isAdmin());
      allow create, update: if isAdmin();
    }

    match /syllabi/{docID} {
      allow read, create: if verified();
      allow update, delete: if isAdmin();
    }

    match /Department/{deptName} {
      allow read: if request.auth != null;
    }

    match /Department/{deptName}/Instructor/{instructorId} {
      allow read: if request.auth != null;
    }
  }
}